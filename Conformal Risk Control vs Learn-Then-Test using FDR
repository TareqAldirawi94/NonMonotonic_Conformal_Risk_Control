library(glmnet)
library(dplyr)
library(ggplot2)

# Parameters
n_seq <- seq(25, 1000, by = 50)
delta <- 0.5
alpha <- 0.1
num_labels <- 5
N <- 100  # Number of trials for averaging

# Helper functions
h1 <- function(a, b) {
  if (a == 0 || a == 1) return(0)
  a * log(a / b) + (1 - a) * log((1 - a) / (1 - b))
}

simulate_multilabel_data <- function(n_samples, n_labels = 5) {
  X <- matrix(rnorm(n_samples * 10), ncol = 10)
  W <- matrix(rnorm(10 * n_labels), ncol = n_labels)
  probs <- 1 / (1 + exp(-X %*% W))
  Y <- matrix(rbinom(n_samples * n_labels, 1, as.vector(probs)), ncol = n_labels)
  list(X = X, Y = Y)
}

fit_predictor <- function(X_train, Y_train) {
  models <- lapply(1:ncol(Y_train), function(j) {
    glm(Y_train[, j] ~ ., data = data.frame(X_train), family = binomial)
  })
  function(X_new) {
    sapply(models, function(model) predict(model, newdata = data.frame(X_new), type = "response"))
  }
}

fdr_loss <- function(y_true, y_pred_set) {
  # FDR = 1 - |Y ∩ C(X)| / |C(X)|
  # where Y is true labels and C(X) is predicted set
  pred_size <- sum(y_pred_set == 1)
  if (pred_size == 0) return(1)  # If no predictions, FDR = 1 (worst case)
  
  intersection <- sum((y_true == 1) & (y_pred_set == 1))
  return(1 - intersection / pred_size)
}

# Initialize results storage
results_df <- data.frame()

set.seed(123)

# ----- Loop over n values -----
for (n in n_seq) {
  m <- 10
  lambda_seq <- seq(0, 1, length.out = m)
  
  ltt_losses <- numeric(N)
  crc_losses <- numeric(N)
  
  for (trial in 1:N) {
    # Simulate data - use more training data
    n_train <- 1000  # Fixed larger training set
    total_needed <- n_train + 2 * n + 100  # train + cal + test
    data <- simulate_multilabel_data(total_needed, num_labels)
    X <- data$X
    Y <- data$Y
    
    # Split data
    X_train <- X[1:n_train, ]
    Y_train <- Y[1:n_train, ]
    X_cal <- X[(n_train + 1):(n_train + n), ]
    Y_cal <- Y[(n_train + 1):(n_train + n), ]
    X_test <- X[(n_train + n + 1):total_needed, ]
    Y_test <- Y[(n_train + n + 1):total_needed, ]
    
    # Train predictor
    predictor <- fit_predictor(X_train, Y_train)
    preds_cal <- predictor(X_cal)
    preds_test <- predictor(X_test)
    
    # ----- LTT Method -----
    empirical_risks <- numeric(m)
    for (j in 1:m) {
      threshold <- lambda_seq[j]  # Changed from 1 - lambda_seq[j]
      pred_set <- (preds_cal >= threshold) * 1
      
      losses <- apply(cbind(Y_cal, pred_set), 1, function(row) {
        y_true <- row[1:num_labels]
        y_pred <- row[(num_labels+1):(2*num_labels)]
        fdr_loss(y_true, y_pred)
      })
      empirical_risks[j] <- mean(losses)
    }
    
    # Debug: print empirical risks for first trial and first n
    if (trial == 1 && n == 25) {
      cat("\n=== Empirical FDR risks on calibration (n=", n, ") ===\n")
      for (j in 1:m) {
        cat(sprintf("  lambda[%d]=%.3f (threshold=lambda), cal FDR=%.3f\n", 
                    j, lambda_seq[j], empirical_risks[j]))
      }
    }
    
    p_values <- numeric(m)
    for (j in 1:m) {
      Rj <- empirical_risks[j]
      Rj_cap <- min(Rj, alpha)
      term1 <- exp(-n * h1(Rj_cap, alpha))
      term2 <- exp(1) * pbinom(ceiling(n * Rj), n, alpha)
      p_values[j] <- min(term1, term2)
    }
    
    threshold_ltt <- delta / m
    valid_indices <- which(p_values <= threshold_ltt)
    lambda_ltt <- if (length(valid_indices) > 0) max(lambda_seq[valid_indices]) else 0  # Changed from min to max, default 0
    
    # Debug output for LTT
    if (trial == 1) {
      # Check what's happening with prediction sets
      threshold <- lambda_ltt  # Changed from 1 - lambda_ltt
      pred_set_test_debug <- ifelse(preds_test >= threshold, 1, 0)
      avg_set_size <- mean(rowSums(pred_set_test_debug))
      sample_fdr <- mean(apply(cbind(Y_test, pred_set_test_debug), 1, function(row) {
        fdr_loss(row[1:num_labels], row[(num_labels+1):(2*num_labels)])
      }))
      
      cat(sprintf("n=%d, LTT lambda=%.3f (threshold=lambda), valid indices=%d, avg set size=%.2f, sample FDR=%.3f\n", 
                  n, lambda_ltt, length(valid_indices), avg_set_size, sample_fdr))
    }
    
    # Test LTT
    threshold <- lambda_ltt  # Changed from 1 - lambda_ltt
    pred_set_test <- ifelse(preds_test >= threshold, 1, 0)
    test_losses <- apply(cbind(Y_test, pred_set_test), 1, function(row) {
      y_true <- row[1:num_labels]
      y_pred <- row[(num_labels+1):(2*num_labels)]
      fdr_loss(y_true, y_pred)
    })
    ltt_losses[trial] <- mean(test_losses)
    
    # ----- CRC Method -----
    valid_lambdas <- c()
    for (j in seq_along(lambda_seq)) {
      lambda_j <- lambda_seq[j]
      threshold <- lambda_j  
      pred_sets_cal <- ifelse(preds_cal >= 1-threshold, 1, 0)
      
      losses <- apply(cbind(Y_cal, pred_sets_cal), 1, function(row) {
        y_true <- row[1:num_labels]
        y_pred <- row[(num_labels+1):(2*num_labels)]
        fdr_loss(y_true, y_pred)
      })
      
      Rn <- mean(losses)
      lhs <- n / (n + 1) * Rn + 1 / (n + 1)
      
      if (lhs <= alpha) {
        valid_lambdas <- c(valid_lambdas, lambda_j)
      }
    }
    lambda_crc <- if (length(valid_lambdas) == 0) 0 else max(valid_lambdas)  # Changed from min to max, default 0
    
    # Debug output for CRC
    if (trial == 1) {
      # Check what's happening with prediction sets
      threshold <- lambda_crc  # Changed from 1 - lambda_crc
      pred_set_test_debug <- ifelse(preds_test >= threshold, 1, 0)
      avg_set_size <- mean(rowSums(pred_set_test_debug))
      sample_fdr <- mean(apply(cbind(Y_test, pred_set_test_debug), 1, function(row) {
        fdr_loss(row[1:num_labels], row[(num_labels+1):(2*num_labels)])
      }))
      
      cat(sprintf("n=%d, CRC lambda=%.3f (threshold=lambda), valid lambdas=%d, avg set size=%.2f, sample FDR=%.3f\n", 
                  n, lambda_crc, length(valid_lambdas), avg_set_size, sample_fdr))
    }
    
    # Test CRC
    threshold <- lambda_crc  # Changed from 1 - lambda_crc
    pred_set_test <- ifelse(preds_test >= threshold, 1, 0)
    test_losses <- apply(cbind(Y_test, pred_set_test), 1, function(row) {
      y_true <- row[1:num_labels]
      y_pred <- row[(num_labels+1):(2*num_labels)]
      fdr_loss(y_true, y_pred)
    })
    crc_losses[trial] <- mean(test_losses)
  }
  
  # Store average results
  results_df <- rbind(results_df, 
                      data.frame(n = n, FDR = mean(ltt_losses), method = "LTT"),
                      data.frame(n = n, FDR = mean(crc_losses), method = "CRC"))
  
  cat(sprintf("Completed n=%d\n", n))
}

# ----- Plot Results -----
p <- ggplot(results_df, aes(x = n, y = FDR, color = method, linetype = method)) +
  geom_line(size = 1.2) +
  geom_point(size = 2.5) +
  geom_hline(yintercept = alpha, linetype = "dashed", color = "black", size = 1) +
  annotate("text", x = max(n_seq) * 0.8, y = alpha + 0.005, 
           label = paste0("α = ", alpha), size = 4) +
  labs(title = "Risk Control Methods Comparison: FDR Loss vs Calibration Size",
       x = "Calibration Sample Size (n)",
       y = "False Discovery Rate (FDR) Loss",
       color = "Method",
       linetype = "Method") +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_text(hjust = 0.5, face = "bold"),
        legend.position = "bottom",
        panel.grid.minor = element_blank()) +
  scale_color_manual(values = c("LTT" = "#E41A1C", "CRC" = "#377EB8")) +
  ylim(0, max(c(results_df$FDR, alpha * 1.5)))

print(p)

# Print summary statistics
summary_stats <- results_df %>%
  group_by(method) %>%
  summarise(
    mean_FDR = mean(FDR),
    max_FDR = max(FDR),
    violations = sum(FDR > alpha),
    pct_violations = 100 * sum(FDR > alpha) / n()
  )
print(summary_stats)

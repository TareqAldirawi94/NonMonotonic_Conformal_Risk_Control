# Synthetic multilabel experiment for non-monotone CRC

set.seed(42)

K <- 10
d <- 15
n_cal <- 10000
n_test <- 500
m <- 100
alpha <- 0.15
B <- 1
n_rep <- 400
n_boot <- 200
crc_c_quantile <- 0.90

c0 <- 0.10
w <- 0.25
a <- 0.50
lambda_grid <- seq(0, 1, length.out = m)
score_noise_sd <- 0.50

sigmoid <- function(x) 1 / (1 + exp(-x))
clip01 <- function(x, eps = 1e-10) pmin(pmax(x, eps), 1 - eps)
mono_right <- function(x) rev(cummax(rev(x)))

D_mn <- function(m, n, B = 1) {
  B * sqrt(log(2 * m) / (2 * n)) +
    B / (2 * sqrt(2 * n * log(2 * m)))
}

crc_adjusted_curve <- function(R_hat, n, B = 1) {
  (n * R_hat + B) / (n + 1)
}

select_first_feasible <- function(curve_plus, level, fallback_curve) {
  ok <- which(curve_plus <= level)
  if (length(ok) > 0) ok[1] else which.min(fallback_curve)
}

W_true <- matrix(rnorm(d * K, mean = 0, sd = 0.65), nrow = d, ncol = K)
b_true <- seq(-0.8, 0.8, length.out = K)

generate_split <- function(n) {
  X <- matrix(rnorm(n * d), nrow = n, ncol = d)
  eta <- X %*% W_true + matrix(rep(b_true, each = n), nrow = n, ncol = K)
  p_true <- sigmoid(eta)
  
  Y <- matrix(
    rbinom(n * K, size = 1, prob = as.vector(p_true)),
    nrow = n,
    ncol = K
  )
  
  eta_hat <- eta + matrix(
    rnorm(n * K, mean = 0, sd = score_noise_sd),
    nrow = n,
    ncol = K
  )
  p_hat <- clip01(sigmoid(eta_hat))
  
  list(Y = Y, p_hat = p_hat)
}

build_loss_matrix <- function(Y, p_hat, lambda_grid) {
  n <- nrow(Y)
  K <- ncol(Y)
  m <- length(lambda_grid)
  
  L <- matrix(NA_real_, nrow = n, ncol = m)
  S <- matrix(NA_real_, nrow = n, ncol = m)
  
  for (j in seq_len(m)) {
    C <- p_hat >= lambda_grid[j]
    set_size <- rowSums(C)
    matched <- rowSums(C & (Y == 1))
    
    precision <- rep(1, n)
    nonempty <- set_size > 0
    precision[nonempty] <- matched[nonempty] / set_size[nonempty]
    
    s <- set_size / K
    penalty <- s * (1 + sin(4 * pi * s)) / 2
    
    L[, j] <- c0 + w * (1 - precision) + a * penalty
    S[, j] <- set_size
  }
  
  list(loss = L, size = S)
}

bootstrap_beta_hat <- function(L_cal, n_boot = 200, q = 0.90) {
  n <- nrow(L_cal)
  R_full <- colMeans(L_cal)
  deviations <- numeric(n_boot)
  
  for (b in seq_len(n_boot)) {
    idx <- sample.int(n, size = n, replace = TRUE)
    R_boot <- colMeans(L_cal[idx, , drop = FALSE])
    deviations[b] <- max(abs(R_boot - R_full))
  }
  
  as.numeric(quantile(deviations, probs = q, names = FALSE, type = 8))
}

select_methods <- function(L_cal) {
  n <- nrow(L_cal)
  m <- ncol(L_cal)
  R_hat <- colMeans(L_cal)
  R_plus <- crc_adjusted_curve(R_hat, n, B)
  
  idx_crc <- select_first_feasible(R_plus, alpha, R_hat)
  
  beta_hat <- bootstrap_beta_hat(L_cal, n_boot, crc_c_quantile)
  alpha_c <- max(alpha - beta_hat, 0.01)
  idx_crcc <- select_first_feasible(R_plus, alpha_c, R_hat)
  
  L_mono <- t(apply(L_cal, 1, mono_right))
  R_loss_mono <- colMeans(L_mono)
  R_loss_mono_plus <- crc_adjusted_curve(R_loss_mono, n, B)
  idx_lossmono <- select_first_feasible(
    R_loss_mono_plus, alpha, R_loss_mono
  )
  
  R_risk_mono <- mono_right(R_hat)
  R_risk_mono_plus <- crc_adjusted_curve(R_risk_mono, n, B)
  idx_riskmono <- select_first_feasible(
    R_risk_mono_plus, alpha, R_risk_mono
  )
  
  D <- D_mn(m, n, B)
  alpha_nm <- alpha - D
  idx_crcnm <- select_first_feasible(R_plus, alpha_nm, R_hat)
  
  c(
    "CRC" = idx_crc,
    "CRC-C" = idx_crcc,
    "Loss Mono" = idx_lossmono,
    "Risk Mono" = idx_riskmono,
    "CRC-NM" = idx_crcnm
  )
}

run_one_rep <- function(rep_id) {
  cal <- generate_split(n_cal)
  tst <- generate_split(n_test)
  
  cal_obj <- build_loss_matrix(cal$Y, cal$p_hat, lambda_grid)
  tst_obj <- build_loss_matrix(tst$Y, tst$p_hat, lambda_grid)
  
  idx <- select_methods(cal_obj$loss)
  method_names <- names(idx)
  
  out <- data.frame(
    rep = rep_id,
    method = method_names,
    index = as.integer(idx),
    lambda = lambda_grid[as.integer(idx)],
    test_risk = NA_real_,
    set_size = NA_real_,
    violation = NA_integer_,
    stringsAsFactors = FALSE
  )
  
  for (k in seq_along(method_names)) {
    j <- as.integer(idx[k])
    out$test_risk[k] <- mean(tst_obj$loss[, j])
    out$set_size[k] <- mean(tst_obj$size[, j])
    out$violation[k] <- as.integer(out$test_risk[k] > alpha)
  }
  
  out
}

sanity <- generate_split(2000)
sanity_obj <- build_loss_matrix(sanity$Y, sanity$p_hat, lambda_grid)

cat("Loss range:\n")
print(range(sanity_obj$loss))
cat("Terminal loss range:\n")
print(range(sanity_obj$loss[, m]))
cat("Theoretical bounds:\n")
print(c(lower = c0, upper = c0 + w + a))

stopifnot(min(sanity_obj$loss) >= -1e-12)
stopifnot(max(sanity_obj$loss) <= 1 + 1e-12)
stopifnot(max(abs(sanity_obj$loss[, m] - c0)) < 1e-10)
stopifnot(c0 <= alpha)

results_list <- vector("list", n_rep)

for (r in seq_len(n_rep)) {
  if (r %% 10 == 0) cat("Completed", r, "of", n_rep, "\n")
  results_list[[r]] <- run_one_rep(r)
}

results <- do.call(rbind, results_list)

method_order <- c("CRC", "CRC-C", "Loss Mono", "Risk Mono", "CRC-NM")
results$method <- factor(results$method, levels = method_order)

summary_table <- do.call(
  rbind,
  lapply(method_order, function(mm) {
    z <- results[results$method == mm, , drop = FALSE]
    data.frame(
      method = mm,
      mean_risk = mean(z$test_risk),
      sd_risk = sd(z$test_risk),
      violation_pct = 100 * mean(z$violation),
      mean_set_size = mean(z$set_size),
      sd_set_size = sd(z$set_size)
    )
  })
)

print(summary_table, row.names = FALSE, digits = 4)

write.csv(results, "synthetic_nonmonotone_raw_results.csv", row.names = FALSE)
write.csv(summary_table, "synthetic_nonmonotone_summary.csv", row.names = FALSE)


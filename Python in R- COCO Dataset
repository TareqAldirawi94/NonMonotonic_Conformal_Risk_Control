# Right-tail supremum helper
mono_right <- function(x) rev(cummax(rev(x)))

# Selection rules
select_crc <- function(loss_mat_sub, level, B_val = 1.0) {
  n <- nrow(loss_mat_sub)
  R_hat <- colMeans(loss_mat_sub, na.rm = TRUE)
  R_hat_plus <- (n * R_hat + B_val) / (n + 1)
  idx <- which(R_hat_plus <= level)
  
  if (length(idx) > 0) {
    return(list(index = min(idx), feasible = TRUE, curve = R_hat_plus))
  } else {
    return(list(index = which.min(R_hat_plus), feasible = FALSE, curve = R_hat_plus))
  }
}

select_loss_mono <- function(loss_mat_sub, level, B_val = 1.0) {
  n <- nrow(loss_mat_sub)
  loss_mono <- t(apply(loss_mat_sub, 1, mono_right))
  R_tilde <- colMeans(loss_mono, na.rm = TRUE)
  R_tilde_plus <- (n * R_tilde + B_val) / (n + 1)
  idx <- which(R_tilde_plus <= level)
  
  if (length(idx) > 0) {
    return(list(index = min(idx), feasible = TRUE, curve = R_tilde_plus))
  } else {
    return(list(index = which.min(R_tilde_plus), feasible = FALSE, curve = R_tilde_plus))
  }
}

select_risk_mono <- function(loss_mat_sub, level, B_val = 1.0) {
  n <- nrow(loss_mat_sub)
  R_hat <- colMeans(loss_mat_sub, na.rm = TRUE)
  R_hat_mono <- mono_right(R_hat)
  R_hat_mono_plus <- (n * R_hat_mono + B_val) / (n + 1)
  idx <- which(R_hat_mono_plus <= level)
  
  if (length(idx) > 0) {
    return(list(index = min(idx), feasible = TRUE, curve = R_hat_mono_plus))
  } else {
    return(list(index = which.min(R_hat_mono_plus), feasible = FALSE, curve = R_hat_mono_plus))
  }
}

estimate_beta <- function(loss_mat_sub, level, n_boot, B_val = 1.0) {
  n <- nrow(loss_mat_sub)
  
  full_sel <- select_crc(loss_mat_sub, level, B_val = B_val)
  full_idx <- full_sel$index
  R_full <- mean(loss_mat_sub[, full_idx], na.rm = TRUE)
  
  deltas <- numeric(n_boot)
  for (b in seq_len(n_boot)) {
    boot_rows <- sample.int(n, n, replace = TRUE)
    L_boot <- loss_mat_sub[boot_rows, , drop = FALSE]
    boot_sel <- select_crc(L_boot, level, B_val = B_val)
    boot_idx <- boot_sel$index
    R_boot <- mean(L_boot[, boot_idx], na.rm = TRUE)
    deltas[b] <- abs(R_boot - R_full)
  }
  
  as.numeric(quantile(deltas, 0.90, na.rm = TRUE))
}

# Storage
all_risk <- matrix(NA_real_, nrow = N_SIMS, ncol = n_methods)
all_setsize <- matrix(NA_real_, nrow = N_SIMS, ncol = n_methods)
all_lambda <- matrix(NA_real_, nrow = N_SIMS, ncol = n_methods)
all_index <- matrix(NA_integer_, nrow = N_SIMS, ncol = n_methods)
all_feasible <- matrix(NA, nrow = N_SIMS, ncol = n_methods)
all_alpha_crcc <- numeric(N_SIMS)
all_beta_hat <- numeric(N_SIMS)

set.seed(42)
cat(sprintf("Running %d simulations...\n", N_SIMS))
pb <- txtProgressBar(min = 0, max = N_SIMS, style = 3)

for (sim in seq_len(N_SIMS)) {
  idx <- sample(n_images)
  cal_idx <- idx[1:N_CAL]
  test_idx <- idx[(N_CAL + 1):(N_CAL + N_TEST)]
  
  sub_cal_L <- loss_mat[cal_idx, , drop = FALSE]
  sub_test_L <- loss_mat[test_idx, , drop = FALSE]
  sub_test_sizes <- set_sizes_mat[test_idx, , drop = FALSE]
  
  # 1. CRC
  sel1 <- select_crc(sub_cal_L, ALPHA, B_val = B)
  li1 <- sel1$index
  all_risk[sim, 1] <- mean(sub_test_L[, li1], na.rm = TRUE)
  all_setsize[sim, 1] <- mean(sub_test_sizes[, li1], na.rm = TRUE)
  all_lambda[sim, 1] <- Lambda[li1]
  all_index[sim, 1] <- li1
  all_feasible[sim, 1] <- sel1$feasible
  
  # 2. CRC-C
  beta_hat <- estimate_beta(sub_cal_L, ALPHA, N_BOOT, B_val = B)
  alpha_crcc <- max(ALPHA - beta_hat, 0.01)
  all_alpha_crcc[sim] <- alpha_crcc
  all_beta_hat[sim] <- beta_hat
  
  sel2 <- select_crc(sub_cal_L, alpha_crcc, B_val = B)
  li2 <- sel2$index
  all_risk[sim, 2] <- mean(sub_test_L[, li2], na.rm = TRUE)
  all_setsize[sim, 2] <- mean(sub_test_sizes[, li2], na.rm = TRUE)
  all_lambda[sim, 2] <- Lambda[li2]
  all_index[sim, 2] <- li2
  all_feasible[sim, 2] <- sel2$feasible
  
  # 3. Loss Mono
  sel3 <- select_loss_mono(sub_cal_L, ALPHA, B_val = B)
  li3 <- sel3$index
  all_risk[sim, 3] <- mean(sub_test_L[, li3], na.rm = TRUE)
  all_setsize[sim, 3] <- mean(sub_test_sizes[, li3], na.rm = TRUE)
  all_lambda[sim, 3] <- Lambda[li3]
  all_index[sim, 3] <- li3
  all_feasible[sim, 3] <- sel3$feasible
  
  # 4. Risk Mono
  sel4 <- select_risk_mono(sub_cal_L, ALPHA, B_val = B)
  li4 <- sel4$index
  all_risk[sim, 4] <- mean(sub_test_L[, li4], na.rm = TRUE)
  all_setsize[sim, 4] <- mean(sub_test_sizes[, li4], na.rm = TRUE)
  all_lambda[sim, 4] <- Lambda[li4]
  all_index[sim, 4] <- li4
  all_feasible[sim, 4] <- sel4$feasible
  
  # 5. CRC-NM
  sel5 <- select_crc(sub_cal_L, ALPHA_PRIME, B_val = B)
  li5 <- sel5$index
  all_risk[sim, 5] <- mean(sub_test_L[, li5], na.rm = TRUE)
  all_setsize[sim, 5] <- mean(sub_test_sizes[, li5], na.rm = TRUE)
  all_lambda[sim, 5] <- Lambda[li5]
  all_index[sim, 5] <- li5
  all_feasible[sim, 5] <- sel5$feasible
  
  setTxtProgressBar(pb, sim)
}
close(pb)


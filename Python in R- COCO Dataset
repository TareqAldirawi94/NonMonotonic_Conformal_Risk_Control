cat("Block 6: Defining IoU and non-monotonic loss functions...\n\n")

xywh_to_xyxy <- function(box) {
  c(box[1], box[2], box[1] + box[3], box[2] + box[4])
}

box_iou <- function(boxA, boxB) {
  A <- xywh_to_xyxy(boxA)
  B <- xywh_to_xyxy(boxB)
  
  ix1 <- max(A[1], B[1])
  iy1 <- max(A[2], B[2])
  ix2 <- min(A[3], B[3])
  iy2 <- min(A[4], B[4])
  
  inter_w <- max(0, ix2 - ix1)
  inter_h <- max(0, iy2 - iy1)
  inter_area <- inter_w * inter_h
  
  areaA <- max(0, (A[3] - A[1]) * (A[4] - A[2]))
  areaB <- max(0, (B[3] - B[1]) * (B[4] - B[2]))
  union_area <- areaA + areaB - inter_area
  
  if (union_area <= 0) return(0)
  inter_area / union_area
}

greedy_match <- function(pred_boxes, pred_scores, gt_boxes, iou_thresh = 0.3) {
  if (is.null(pred_boxes) || nrow(pred_boxes) == 0 ||
      is.null(gt_boxes) || nrow(gt_boxes) == 0) {
    return(list(n_matched = 0))
  }
  
  order_idx <- order(pred_scores, decreasing = TRUE)
  gt_used <- rep(FALSE, nrow(gt_boxes))
  n_matched <- 0
  
  for (pi in order_idx) {
    best_iou <- 0
    best_gi <- NA
    
    for (gi in seq_len(nrow(gt_boxes))) {
      if (gt_used[gi]) next
      iou <- box_iou(pred_boxes[pi, ], gt_boxes[gi, ])
      if (iou > best_iou) {
        best_iou <- iou
        best_gi <- gi
      }
    }
    
    if (!is.na(best_gi) && best_iou >= iou_thresh) {
      n_matched <- n_matched + 1
      gt_used[best_gi] <- TRUE
    }
  }
  
  list(n_matched = n_matched)
}

# Recall-style miss loss
miss_loss <- function(n_matched, n_gt) {
  if (n_gt == 0) return(0.0)
  1 - (n_matched / n_gt)
}

# Soft oversize penalty:
# zero up to K0, then ramps linearly to 1 over TAU detections
soft_oversize_penalty <- function(C_size, K0 = 5, TAU = 6) {
  oversize_amount <- max(C_size - K0, 0)
  min(oversize_amount / TAU, 1.0)
}

# Final non-monotonic detection loss:
# recall improves as lambda grows, but oversized detection sets are penalized
loss_nonmonotone_detection <- function(n_matched, n_gt, C_size,
                                       gamma = 0.35, K0 = 5, TAU = 6) {
  base_loss <- miss_loss(n_matched, n_gt)
  size_penalty <- soft_oversize_penalty(C_size, K0 = K0, TAU = TAU)
  (1 - gamma) * base_loss + gamma * size_penalty
}


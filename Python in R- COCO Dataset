predict_one_image <- function(img_path, score_min = 0.0) {
  # Run Faster R-CNN inference on a single image.
  #
  # Args:
  #   img_path: Path to image file
  #   score_min: Minimum confidence score threshold
  #
  # Returns:
  #   List with:
  #     - boxes: N x 4 matrix (x, y, width, height format)
  #     - scores: N-vector of confidence scores
  #     - labels: N-vector of class labels
  
  if (!file.exists(img_path)) {
    warning("Image not found: ", img_path)
    return(list(
      boxes = matrix(numeric(0), 0, 4),
      scores = numeric(0),
      labels = integer(0)
    ))
  }
  
  tryCatch({
    # Run inference via Python
    py_run_string(sprintf("
from PIL import Image
import torchvision.transforms as T

img = Image.open('%s').convert('RGB')
transform = T.ToTensor()
img_tensor = transform(img).unsqueeze(0)

with torch.no_grad():
    predictions = model_py(img_tensor)

pred_dict = predictions[0]
", gsub("\\\\", "/", img_path)))
    
    # Extract predictions
    boxes_py <- py$pred_dict$boxes$cpu()$numpy()
    scores_py <- as.numeric(py$pred_dict$scores$cpu()$numpy())
    labels_py <- as.integer(py$pred_dict$labels$cpu()$numpy())
    
    # Handle empty predictions
    if (length(scores_py) == 0) {
      return(list(
        boxes = matrix(numeric(0), 0, 4),
        scores = numeric(0),
        labels = integer(0)
      ))
    }
    
    # Filter by score threshold
    keep_idx <- which(scores_py >= score_min)
    
    if (length(keep_idx) == 0) {
      return(list(
        boxes = matrix(numeric(0), 0, 4),
        scores = numeric(0),
        labels = integer(0)
      ))
    }
    
    # Convert boxes from xyxy to xywh format
    boxes_xyxy <- boxes_py[keep_idx, , drop = FALSE]
    boxes_xywh <- cbind(
      boxes_xyxy[, 1],                      # x
      boxes_xyxy[, 2],                      # y
      boxes_xyxy[, 3] - boxes_xyxy[, 1],    # width
      boxes_xyxy[, 4] - boxes_xyxy[, 2]     # height
    )
    
    return(list(
      boxes = boxes_xywh,
      scores = scores_py[keep_idx],
      labels = labels_py[keep_idx]
    ))
    
  }, error = function(e) {
    warning("Prediction failed for ", img_path, ": ", e$message)
    return(list(
      boxes = matrix(numeric(0), 0, 4),
      scores = numeric(0),
      labels = integer(0)
    ))
  })
}


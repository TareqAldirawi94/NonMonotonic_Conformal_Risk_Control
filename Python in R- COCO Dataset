# Step 6 - Modified version to handle large integers:

# Pass coco_obj to Python
py$coco_obj <- coco_obj

# Create Python helper functions that convert large ints to strings
py_run_string("
def get_image_data(coco_obj, img_id):
    img = coco_obj.loadImgs(int(img_id))[0]
    return {
        'image_id': str(img_id),  # Convert to string to avoid overflow
        'file_name': str(img['file_name']),
        'width': int(img['width']),
        'height': int(img['height'])
    }

def get_annotation_data(coco_obj, img_id):
    ann_ids = coco_obj.getAnnIds(imgIds=int(img_id))
    anns = coco_obj.loadAnns(ann_ids)
    result = []
    for ann in anns:
        result.append({
            'image_id': str(img_id),  # Convert to string
            'ann_id': str(ann['id']),  # Convert to string
            'cat_id': int(ann['category_id']),  # Category IDs are small, keep as int
            'bbox_x': float(ann['bbox'][0]),
            'bbox_y': float(ann['bbox'][1]),
            'bbox_w': float(ann['bbox'][2]),
            'bbox_h': float(ann['bbox'][3]),
            'area': float(ann['area'])
        })
    return result
")

# Now extract data for first 100 images
n_images <- 100
images_list <- list()
annotations_list <- list()

cat("Extracting data from COCO...\n")
for(i in 1:n_images) {
  if(i %% 20 == 0) cat("Processing image", i, "of", n_images, "\n")
  
  img_id <- img_ids[i]
  
  # Get image data
  img_data <- py_eval(sprintf("get_image_data(coco_obj, %s)", img_id))
  images_list[[i]] <- img_data
  
  # Get annotations
  ann_data <- py_eval(sprintf("get_annotation_data(coco_obj, %s)", img_id))
  if(length(ann_data) > 0) {
    annotations_list <- c(annotations_list, ann_data)
  }
}


# Load a pre-trained Faster R-CNN model (trained on COCO)
cat("Loading pre-trained Faster R-CNN model...\n")
model <- model_fasterrcnn_resnet50_fpn(pretrained = TRUE, progress = TRUE)
model$eval()  # Set to evaluation mode

# Create a function to preprocess images
transform <- function(img_path) {
  img <- torchvision::base_loader(img_path)
  img <- torchvision::transform_to_tensor(img)
  return(img)
}

# Test on one image first
test_img_path <- coco_data$images$file_path[1]
cat("Testing on image:", test_img_path, "\n")

# Load and preprocess the image
img_tensor <- transform(test_img_path)
img_batch <- torch_unsqueeze(img_tensor, 1)  # Add batch dimension

# Get predictions
cat("Running inference...\n")
with_no_grad({
  predictions <- model(img_batch)
})

# Check predictions structure
pred <- predictions[[1]]
cat("\nPrediction components:\n")
cat("- Number of detected objects:", length(pred$labels), "\n")
cat("- Prediction keys:", names(pred), "\n")

# Extract prediction components
if(length(pred$labels) > 0) {
  # Convert to R
  detection_boxes <- as.matrix(pred$boxes$cpu())
  detection_labels <- as.integer(pred$labels$cpu())
  detection_scores <- as.numeric(pred$scores$cpu())
  
  cat("\nFirst few detections:\n")
  for(i in 1:min(3, length(detection_labels))) {
    cat(sprintf("  Object %d: Class %d, Score %.3f\n", 
                i, detection_labels[i], detection_scores[i]))

cat("Block 6: Defining IoU and matching functions...\n\n")

# Convert bounding box from xywh to xyxy format
xywh_to_xyxy <- function(box) {
  # Convert box from (x, y, w, h) to (x1, y1, x2, y2) format
  c(box[1], box[2], box[1] + box[3], box[2] + box[4])
}

# Compute Intersection over Union between two boxes
box_iou <- function(boxA, boxB) {
  # Compute IoU between two boxes in xywh format.
  #
  # Args:
  #   boxA: Box A as (x, y, w, h)
  #   boxB: Box B as (x, y, w, h)
  #
  # Returns:
  #   IoU value in [0, 1]
  
  A <- xywh_to_xyxy(boxA)
  B <- xywh_to_xyxy(boxB)
  
  # Intersection coordinates
  ix1 <- max(A[1], B[1])
  iy1 <- max(A[2], B[2])
  ix2 <- min(A[3], B[3])
  iy2 <- min(A[4], B[4])
  
  # Intersection area
  inter_w <- max(0, ix2 - ix1)
  inter_h <- max(0, iy2 - iy1)
  inter_area <- inter_w * inter_h
  
  # Individual areas
  areaA <- max(0, (A[3] - A[1]) * (A[4] - A[2]))
  areaB <- max(0, (B[3] - B[1]) * (B[4] - B[2]))
  
  # Union area
  union_area <- areaA + areaB - inter_area
  
  if (union_area <= 0) return(0)
  
  inter_area / union_area
}

# Greedy matching algorithm
greedy_match <- function(pred_boxes, pred_scores, gt_boxes,
                         iou_thresh = 0.5, class_aware = FALSE,
                         pred_labels = NULL, gt_labels = NULL) {
  # Greedy matching of predictions to ground truth boxes.
  # Matches are made in order of decreasing prediction confidence.
  #
  # Args:
  #   pred_boxes: N_pred x 4 matrix of prediction boxes (xywh)
  #   pred_scores: N_pred vector of confidence scores
  #   gt_boxes: N_gt x 4 matrix of ground truth boxes (xywh)
  #   iou_thresh: Minimum IoU for a valid match
  #   class_aware: Whether to require class labels to match
  #   pred_labels: N_pred vector of predicted class labels
  #   gt_labels: N_gt vector of ground truth class labels
  #
  # Returns:
  #   List with:
  #     - matched_pred_idx: Indices of matched predictions
  #     - matched_gt_idx: Indices of matched ground truth
  #     - n_matched: Number of matches
  
  # Handle empty inputs
  if (is.null(pred_boxes) || nrow(pred_boxes) == 0 ||
      is.null(gt_boxes) || nrow(gt_boxes) == 0) {
    return(list(
      matched_pred_idx = integer(0),
      matched_gt_idx = integer(0),
      n_matched = 0
    ))
  }
  
  # Sort predictions by score (descending)
  order_idx <- order(pred_scores, decreasing = TRUE)
  
  matched_pred <- integer(0)
  matched_gt <- integer(0)
  gt_used <- rep(FALSE, nrow(gt_boxes))
  
  # Greedy matching
  for (pi in order_idx) {
    best_iou <- 0
    best_gi <- NA_integer_
    
    # Find best matching ground truth for this prediction
    for (gi in seq_len(nrow(gt_boxes))) {
      if (gt_used[gi]) next
      
      # Class filtering if needed
      if (class_aware && !is.null(pred_labels) && !is.null(gt_labels)) {
        if (pred_labels[pi] != gt_labels[gi]) next
      }
      
      # Compute IoU
      iou <- box_iou(pred_boxes[pi, ], gt_boxes[gi, ])
      
      if (iou > best_iou) {
        best_iou <- iou
        best_gi <- gi
      }
    }
    
    # Match if IoU exceeds threshold
    if (!is.na(best_gi) && best_iou >= iou_thresh) {
      matched_pred <- c(matched_pred, pi)
      matched_gt <- c(matched_gt, best_gi)
      gt_used[best_gi] <- TRUE
    }
  }
  
  list(
    matched_pred_idx = matched_pred,
    matched_gt_idx = matched_gt,
    n_matched = length(matched_pred)
  )
}

# Precision loss function
precision_loss <- function(n_matched, C_size) {
  # Compute precision-based loss: 1 - precision.
  #
  # Args:
  #   n_matched: Number of predictions that matched ground truth
  #   C_size: Total number of predictions
  #
  # Returns:
  #   Loss value in [0, 1]
  
  if (C_size == 0) return(1.0)
  
  # Ensure n_matched <= C_size
  n_matched <- min(n_matched, C_size)
  
  # Loss = 1 - precision
  1 - (n_matched / C_size)
}


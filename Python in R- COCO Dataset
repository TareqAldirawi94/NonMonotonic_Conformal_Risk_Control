}

inference_time <- as.numeric(difftime(Sys.time(), start_time, units = "mins"))
cat(sprintf("\n✓ Inference complete! Time: %.1f minutes\n\n", inference_time))

# Compute loss matrix
cat("Computing loss matrix...\n")
loss_mat <- matrix(NA_real_, nrow = n_cal, ncol = length(Lambda))

for (i in seq_len(n_cal)) {
  img_id <- cal_img_ids[i]
  
  # Get ground truth boxes
  gt_df <- gt_by_image[[as.character(img_id)]]
  if (is.null(gt_df) || nrow(gt_df) == 0) {
    gt_boxes <- matrix(numeric(0), nrow = 0, ncol = 4)
  } else {
    gt_boxes <- as.matrix(gt_df[, c("bbox_x", "bbox_y", "bbox_w", "bbox_h")])
  }
  
  # Get predictions
  preds <- preds_cache[[i]]
  pred_boxes <- preds$boxes
  pred_scores <- preds$scores
  
  # Compute loss for each lambda
  for (j in seq_along(Lambda)) {
    lambda <- Lambda[j]
    score_thresh <- 1 - lambda
    
    # Handle empty predictions
    if (is.null(pred_scores) || length(pred_scores) == 0 ||
        is.null(pred_boxes) || nrow(pred_boxes) == 0) {
      loss_mat[i, j] <- 1.0
      next
    }
    
    # Filter predictions by threshold
    C_idx <- which(pred_scores >= score_thresh)
    C_size <- length(C_idx)
    
    if (C_size == 0) {
      loss_mat[i, j] <- 1.0
      next
    }
    
    C_boxes <- pred_boxes[C_idx, , drop = FALSE]
    C_scores <- pred_scores[C_idx]
    
    # Match predictions to ground truth
    match_res <- greedy_match(C_boxes, C_scores, gt_boxes, iou_thresh = tau_iou)
    
    n_matched <- if (!is.null(match_res$n_matched)) {
      match_res$n_matched
    } else {
      length(match_res$matched_gt_idx)
    }
    
    # Compute precision loss
    loss_mat[i, j] <- precision_loss(n_matched, C_size)
  }
  
  if (verbose && i %% 100 == 0) {
    cat(sprintf("  Loss matrix: %d/%d (%.1f%%)\n", i, n_cal, 100*i/n_cal))
  }
}

cat("✓ Loss matrix complete!\n\n")

# Boundedness check
empirical_max <- max(loss_mat, na.rm = TRUE)
if (empirical_max > B + 1e-12) {
  warning(sprintf("Empirical loss max = %.4f exceeds B = %.4f",
                  empirical_max, B))
} else {
  cat(sprintf("✓ Empirical loss max = %.4f <= B = %.4f (OK)\n",
              empirical_max, B))
}

# CRC Theorem Selection
cat("\nApplying CRC theorem...\n")

n <- n_cal
hat_R_n <- colMeans(loss_mat, na.rm = TRUE)
lhs_vals <- (n / (n + 1)) * hat_R_n + (B / (n + 1))
feasible_idx <- which(lhs_vals <= alpha)

if (length(feasible_idx) == 0) {
  warning("No lambda satisfies the theorem bound <= alpha. Using conservative fallback.")
  lambda_hat <- max(Lambda)
  chosen_idx <- which.min(abs(Lambda - lambda_hat))
} else {
  chosen_idx <- min(feasible_idx)
  lambda_hat <- Lambda[chosen_idx]
  cat(sprintf("✓ Found %d feasible lambdas\n", length(feasible_idx)))
}

excess_bound <- B * sqrt(log(2 * m) / (2 * n))

cat("\n")
cat(rep("=", 80), "\n", sep = "")
cat("CRC CALIBRATION RESULTS\n")
cat(rep("=", 80), "\n", sep = "")
cat(sprintf("  Chosen lambda: %.4f\n", lambda_hat))
cat(sprintf("  Score threshold: %.4f\n", 1 - lambda_hat))
cat(sprintf("  Calibration risk: %.6f\n", hat_R_n[chosen_idx]))
cat(sprintf("  Excess bound: %.6f\n", excess_bound))
cat(sprintf("  Theoretical risk bound: %.6f (alpha + excess)\n", alpha + excess_bound))
cat(sprintf("  Feasible lambdas: %d / %d\n", length(feasible_idx), length(Lambda)))
cat(rep("=", 80), "\n\n", sep = "")


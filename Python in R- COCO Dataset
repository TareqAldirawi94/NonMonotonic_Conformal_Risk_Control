for (i in seq_len(n_cal)) {
  if (verbose && i %% 50 == 0) {
    elapsed <- as.numeric(difftime(Sys.time(), start_time, units = "mins"))
    rate <- i / elapsed
    remaining <- (n_cal - i) / rate
    cat(sprintf("  Inference: %d/%d (%.1f%%) - %.1f min elapsed, %.1f min remaining\n",
                i, n_cal, 100*i/n_cal, elapsed, remaining))
  }
  

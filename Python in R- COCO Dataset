# Download helper function
download_if_missing <- function(url, dest_dir) {
  fname <- basename(url)
  dest_file <- file.path(dest_dir, fname)
  if (file.exists(dest_file)) {
    message("Already present: ", fname)
    return(dest_file)
  }
  message("Downloading ", fname, " ... (this can be large)")
  utils::download.file(url, dest_file, mode = "wb")
  message("Downloaded: ", dest_file)
  dest_file
}


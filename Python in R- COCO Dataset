  img_path <- test_file_paths[k]
  img_id <- test_img_ids[k]
  
  if (!file.exists(img_path)) {
    test_losses[k] <- 1.0
    next
  }
  
  # Get predictions
  preds <- predict_one_image(img_path, score_min = 0.0)
  
  if (is.null(preds) || is.null(preds$boxes) || nrow(preds$boxes) == 0 ||
      is.null(preds$scores) || length(preds$scores) == 0) {
    test_losses[k] <- 1.0
    next
  }
  
  pred_boxes <- preds$boxes
  pred_scores <- preds$scores
  
  # Apply threshold
  C_idx <- which(pred_scores >= thr)
  C_size <- length(C_idx)
  
  # Get ground truth
  gt_df_k <- gt_by_image[[as.character(img_id)]]
  gt_boxes_k <- if (is.null(gt_df_k) || nrow(gt_df_k) == 0) {
    matrix(numeric(0), nrow = 0, ncol = 4)
  } else {
    as.matrix(gt_df_k[, c("bbox_x", "bbox_y", "bbox_w", "bbox_h")])
  }
  
  if (C_size == 0) {
    test_losses[k] <- 1.0
  } else {
    C_boxes_k <- pred_boxes[C_idx, , drop = FALSE]
    C_scores_k <- pred_scores[C_idx]
    
    match_res_k <- greedy_match(C_boxes_k, C_scores_k, gt_boxes_k, 
                                iou_thresh = tau_iou)
    
    n_matched_k <- if (!is.null(match_res_k$n_matched)) {
      match_res_k$n_matched
    } else {
      length(match_res_k$matched_gt_idx)
    }
    
    test_losses[k] <- precision_loss(n_matched_k, C_size)
  }
  
  if (verbose && k %% 50 == 0) {
    elapsed <- as.numeric(difftime(Sys.time(), test_start, units = "mins"))
    rate <- k / elapsed
    remaining <- (n_test - k) / rate
    cat(sprintf("  Test eval: %d/%d (%.1f%%) - %.1f min elapsed, %.1f min remaining\n",
                k, n_test, 100*k/n_test, elapsed, remaining))
  }
}

